# Opțional. Implicit frontend-ul apelează /api/* și Vite le trimite la backend (proxy).

# Adresa backend-ului pentru proxy-ul din `npm run dev` / `npm run preview`
VITE_PROXY_TARGET=http://localhost:8080

# Dacă vrei ca browserul să apeleze direct backend-ul (fără proxy), setează adresa lui.
# Backend-ul permite deja http://localhost:5173 prin CORS_ALLOWED_ORIGINS.
# VITE_API_URL=http://localhost:8080
